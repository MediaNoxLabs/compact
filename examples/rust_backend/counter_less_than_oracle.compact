import CompactStandardLibrary;
export ledger low: Counter;
export ledger high: Counter;
constructor() { low.increment(3); high.increment(7); }
export circuit compare(threshold: Uint<64>): Boolean { return low.lessThan(disclose(threshold)); }
export circuit nested(): Boolean { return low.lessThan(high); }
export circuit short_circuit(run: Boolean): Boolean { return disclose(run) && low.lessThan(high); }
export circuit checked(threshold: Uint<64>): [] { assert(low.lessThan(disclose(threshold)), "counter guard"); }
