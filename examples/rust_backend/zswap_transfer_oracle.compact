import CompactStandardLibrary;
export ledger pot: QualifiedShieldedCoinInfo;

// One distinct output; the offer and Kernel claims must match the actual spend.
export circuit transfer(input: QualifiedShieldedCoinInfo, coin: ShieldedCoinInfo,
                        recipient: Either<ZswapCoinPublicKey, ContractAddress>,
                        nullifier: Bytes<32>, commitment: Bytes<32>): [] {
  createZswapInput(input);
  kernel.claimZswapNullifier(disclose(nullifier));
  createZswapOutput(coin, recipient);
  kernel.claimZswapCoinSpend(disclose(commitment));
  pot.writeCoin(disclose(coin), disclose(recipient));
}
export circuit read_coin(): QualifiedShieldedCoinInfo { return pot; }
