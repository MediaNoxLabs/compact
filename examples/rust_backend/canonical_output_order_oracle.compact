import CompactStandardLibrary;
export ledger pot: QualifiedShieldedCoinInfo;
export circuit distribute(input: QualifiedShieldedCoinInfo,
  sent: ShieldedCoinInfo, change: ShieldedCoinInfo,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>,
  selfRecipient: Either<ZswapCoinPublicKey, ContractAddress>,
  nullifier: Bytes<32>, sentCommitment: Bytes<32>, changeCommitment: Bytes<32>): [] {
  createZswapInput(input);
  kernel.claimZswapNullifier(disclose(nullifier));
  createZswapOutput(sent, recipient);
  kernel.claimZswapCoinSpend(disclose(sentCommitment));
  createZswapOutput(change, selfRecipient);
  kernel.claimZswapCoinSpend(disclose(changeCommitment));
  kernel.claimZswapCoinReceive(disclose(changeCommitment));
  pot.writeCoin(disclose(change), disclose(selfRecipient));
}
export circuit read_coin(): QualifiedShieldedCoinInfo { return pot; }
