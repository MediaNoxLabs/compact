import CompactStandardLibrary;
export ledger pot: QualifiedShieldedCoinInfo;
witness next_coin(): ShieldedCoinInfo;
witness next_recipient(): Either<ZswapCoinPublicKey, ContractAddress>;

export circuit produce(coin: ShieldedCoinInfo, recipient: Either<ZswapCoinPublicKey, ContractAddress>): [] {
  return createZswapOutput(coin, recipient);
}
export circuit consume(coin: QualifiedShieldedCoinInfo): [] {
  return createZswapInput(coin);
}
circuit pair(coin: ShieldedCoinInfo, recipient: Either<ZswapCoinPublicKey, ContractAddress>): [] {
  createZswapOutput(coin, recipient);
  createZswapOutput(coin, recipient);
}
export circuit flow(input: QualifiedShieldedCoinInfo, coin: ShieldedCoinInfo, recipient: Either<ZswapCoinPublicKey, ContractAddress>, selected: Boolean): [] {
  createZswapInput(input);
  if (disclose(selected)) {
    pair(coin, recipient);
    pot.writeCoin(disclose(coin), disclose(recipient));
  }
}
export circuit witness_order(selected: Boolean): [] {
  if (selected) { createZswapOutput(next_coin(), next_recipient()); }
}
export circuit read_coin(): QualifiedShieldedCoinInfo { return pot; }
