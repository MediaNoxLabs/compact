import CompactStandardLibrary;

export ledger t: HistoricMerkleTree<3, Uint<8>>;

export circuit append(value: Uint<8>): [] {
  t.insert(disclose(value));
}

export circuit place(value: Uint<8>, index: Uint<64>): [] {
  t.insertIndex(disclose(value), disclose(index));
}

export circuit forget_history(): [] {
  t.resetHistory();
}
