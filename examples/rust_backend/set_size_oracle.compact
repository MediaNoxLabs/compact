//
// A20: Set.isEmpty / Map.isEmpty fixture. Exercises the read-no-arg ADT
// gather-lowering path so a divergence between the Rust and TS sides
// surfaces as a byte-parity failure rather than a silent miscompile.
//
// Before A20, the codegen emitted a hardcoded `dup → idx → popeq`
// template for every no-arg ADT read regardless of the underlying
// vm-code, silently miscompiling Set.size / Set.isEmpty / Map.size /
// Map.isEmpty / List.isEmpty / List.length to read the container cell
// as the result AlignedValue. A20 routes the adt-op's actual vm-code
// through `expand-vm-code` like the read-with-arg path (Set.member,
// HMT.checkRoot), so the gather chain reflects the real instruction
// sequence:
//
//   Set.isEmpty   → (dup 0) (idx ...) (size) (push align-0-8) (eq)
//                   (popeq cached=true)
//   Map.isEmpty   → identical shape on the Map container.
//
// Two exported circuits, one per ADT, both lowering to the same
// `.dup(0).idx_at_index(N,false).size().push(false,new_cell(0u64))
//  .eq().popeq(true)` gather chain — confirming the A20 fix covers
// both Set and Map containers, not just one.

import CompactStandardLibrary;

export ledger flag_set: Boolean;
export ledger flag_map: Boolean;
export ledger s: Set<Field>;
export ledger m: Map<Field, Field>;

export circuit check_set_empty(): [] {
  flag_set.write(disclose(s.isEmpty()));
}

export circuit check_map_empty(): [] {
  flag_map.write(disclose(m.isEmpty()));
}
