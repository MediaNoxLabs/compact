import CompactStandardLibrary;

export circuit choose(flag: Boolean, left: Field, right: Field): Field {
  if (flag) {
    return left;
  } else {
    return right;
  }
}

export circuit sum_with_local(left: Field, right: Field): Field {
  const total = left + right;
  const doubled = total + total;
  return doubled;
}

export circuit call_sum(left: Field, right: Field): Field {
  return sum_with_local(left, right);
}

export circuit answer(): Field {
  return 42;
}

export circuit wide_constant(): Field {
  return 18446744073709551616;
}
