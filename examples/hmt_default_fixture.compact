//
// A21: HistoricMerkleTree.insertIndexDefault fixture. Exercises the
// bounded-index `insert*Index*` vm-code shape — `(dup 1)(dup 1)(lt)
// (branch 2)(pop)(jmp 2)(swap 0)(pop)` for the
// `max(old_first_free, index + 1)` first-free update, plus
// `(push true (state-value 'cell (rt-leaf-hash (rt-null value_type))))`
// for the default leaf — so a divergence between the Rust and TS sides
// surfaces as a byte-parity failure rather than a silent miscompile.
//
// Before A21, `compactc --rust` rejected any circuit body that called
// `t.insertIndexDefault(idx)` with `circuit-body-emission: no walker
// shape matched`. A21 widened `vminstr->builder-call` to render the
// bounded-index branch sequence + `vm-cell-elem->rust` to render
// `VMnull T` via `default-value-rust`, mirroring the TS reference's
// `default(value_type)` lowering.
//
// Two exported circuits — one mutating, one reading — let the test
// fixture capture three TS reference snapshots (init → after
// add_default(0) → after add_default(2)) and assert each Rust step
// serialises to the same bytes.

import CompactStandardLibrary;

export ledger t: HistoricMerkleTree<3, Uint<8>>;

export circuit add_default(idx: Uint<64>): [] {
  t.insertIndexDefault(disclose(idx));
}
