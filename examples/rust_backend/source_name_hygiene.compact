import CompactStandardLibrary;

struct Option { amount: Field; active: Boolean; }
struct Fr { amount: Field; active: Boolean; }
struct MemWrite { amount: Field; active: Boolean; }
struct runtime { amount: Field; active: Boolean; }
struct FieldRepr { amount: Field; active: Boolean; }
struct Vec { amount: Field; active: Boolean; }
struct Result { amount: Field; active: Boolean; }
struct From { amount: Field; active: Boolean; }
struct Empty {}
struct Names {
  option_value: Option;
  fr_value: Fr;
  memwrite_value: MemWrite;
  runtime_value: runtime;
  fieldrepr_value: FieldRepr;
  vec_value: Vec;
  result_value: Result;
  from_value: From;
  empty: Empty;
  nested: Vector<2, Option>;
}

export circuit round_trip(value: Names): Names { return value; }
