import CompactStandardLibrary;

export ledger coins: Set<QualifiedShieldedCoinInfo>;

export circuit insert_coin(
  coin: ShieldedCoinInfo,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>
): [] {
  coins.insertCoin(disclose(coin), disclose(recipient));
}

export circuit contains(coin: QualifiedShieldedCoinInfo): Boolean {
  return coins.member(disclose(coin));
}
