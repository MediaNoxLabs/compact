import CompactStandardLibrary;

// Eighteen declarations place active at [1, 14] and amount at [1, 13].
export ledger f00: Uint<64>;
export ledger f01: Uint<64>;
export ledger f02: Uint<64>;
export ledger f03: Uint<64>;
export ledger f04: Uint<64>;
export ledger f05: Uint<64>;
export ledger f06: Uint<64>;
export ledger f07: Uint<64>;
export ledger f08: Uint<64>;
export ledger f09: Uint<64>;
export ledger f10: Uint<64>;
export ledger f11: Uint<64>;
export ledger f12: Uint<64>;
export ledger f13: Uint<64>;
export ledger f14: Uint<64>;
export ledger f15: Uint<64>;
export ledger amount: Field;
export ledger active: Boolean;

constructor() {
  amount = 3 as Field;
  active = true;
}

export circuit set_active(next: Boolean): [] { active = disclose(next); }
export circuit get_active(): Boolean { return active.read(); }
export circuit assert_active(expected: Boolean): [] {
  assert(active.read() == disclose(expected), "active mismatch");
}
export circuit set_amount(next: Field): [] { amount = disclose(next); }
export circuit get_amount(): Field { return amount.read(); }
export circuit add_amount(delta: Field): [] {
  amount = amount.read() + disclose(delta);
}
