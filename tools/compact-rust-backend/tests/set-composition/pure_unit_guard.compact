import CompactStandardLibrary;
export ledger active: Boolean;
export enum Mutation { Undefined, Insert, Remove }
circuit defined(m: Mutation): [] {
  assert(m == Mutation.Insert || m == Mutation.Remove, "undefined mutation");
}
circuit update(): [] { active = true; }
export circuit run(m: Mutation): [] { defined(disclose(m)); update(); }
circuit localGuard(m: Mutation): [] {
  const allowed = m == Mutation.Insert || m == Mutation.Remove;
  assert(allowed, "local undefined mutation");
}
circuit transitiveGuard(m: Mutation): [] { localGuard(m); }
export circuit local_control(m: Mutation): [] { localGuard(disclose(m)); update(); }
export circuit transitive_control(m: Mutation): [] { transitiveGuard(disclose(m)); update(); }
