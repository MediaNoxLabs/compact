import CompactStandardLibrary;

witness secret(): Field;
witness ordered(): Field;
export ledger value: Field;

circuit inner(next: Field): [] {
  value = disclose(secret()) + next;
}

circuit middle(next: Field): [] {
  inner(next);
}

export circuit outer(): [] {
  middle(value);
}

circuit innerValue(): Field {
  return disclose(secret());
}

export circuit outerValue(): [] {
  value = innerValue();
}

circuit innerValue2(first: Field, second: Field): Field {
  return disclose(ordered()) + first + second;
}

export circuit outerValue2(): [] {
  value = innerValue2(disclose(ordered()), disclose(ordered()));
}
