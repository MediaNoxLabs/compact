import CompactStandardLibrary;

// The sixteenth declaration occupies physical ledger path [1, 14].
export ledger f00: Uint<64>;
export ledger f01: Uint<64>;
export ledger f02: Uint<64>;
export ledger f03: Uint<64>;
export ledger f04: Uint<64>;
export ledger f05: Uint<64>;
export ledger f06: Uint<64>;
export ledger f07: Uint<64>;
export ledger f08: Uint<64>;
export ledger f09: Uint<64>;
export ledger f10: Uint<64>;
export ledger f11: Uint<64>;
export ledger f12: Uint<64>;
export ledger f13: Uint<64>;
export ledger f14: Uint<64>;
export ledger items: List<Field>;

constructor() {
  items.pushFront(1 as Field);
}

export circuit item_count(): Uint<64> { return items.length(); }
export circuit items_empty(): Boolean { return items.isEmpty(); }
export circuit first_item(): Maybe<Field> { return items.head(); }
export circuit prepend(value: Field): [] { items.pushFront(disclose(value)); }
export circuit drop_first(): [] { items.popFront(); }
export circuit clear_items(): [] { items.resetToDefault(); }
