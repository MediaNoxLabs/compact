import CompactStandardLibrary;
export ledger key: JubjubPoint;
export ledger active: Boolean;
constructor(initial: JubjubPoint) { key = disclose(initial); active = true; }
circuit put(value: JubjubPoint): [] { key = disclose(value); }
export circuit through_helper(value: JubjubPoint): [] { put(value); }
export circuit direct_control(value: JubjubPoint): [] { key = disclose(value); }

circuit guard(): [] { assert(active, "inactive"); }
export circuit guarded(value: JubjubPoint): [] { guard(); key = disclose(value); }
