import CompactStandardLibrary;

export ledger state: Field;
export ledger unused: Field;
witness mark(): Field;

export circuit choose(next: Field): Field {
  const before = state.read();
  state.write(before + 1);
  if (state.read() == 1) {
    const selected = before;
    state.write(disclose(next));
    return selected;
  } else {
    const offset = 100;
    unused.write(disclose(mark()));
    return before + offset;
  }
}
