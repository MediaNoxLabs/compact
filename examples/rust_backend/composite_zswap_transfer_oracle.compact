import CompactStandardLibrary;
export ledger marker: Field;
export struct Transfer {
  first: Uint<128>;
  consumed: [];
  claimed_input: [];
  emitted: [];
  claimed_output: [];
  address: ContractAddress;
  after: Uint<128>;
}
witness next_value(tag: Uint<8>): Uint<64>;

// Actual upstream nullifier/commitment bind the exact funded offer; no change.
export circuit transfer(input: QualifiedShieldedCoinInfo, coin: ShieldedCoinInfo,
                        recipient: Either<ZswapCoinPublicKey, ContractAddress>,
                        nullifier: Bytes<32>, commitment: Bytes<32>): Transfer {
  return Transfer {
    first: disclose(next_value(3)) as Uint<128>,
    consumed: createZswapInput(input),
    claimed_input: kernel.claimZswapNullifier(disclose(nullifier)),
    emitted: createZswapOutput(coin, recipient),
    claimed_output: kernel.claimZswapCoinSpend(disclose(commitment)),
    address: kernel.self(),
    after: disclose(next_value(4)) as Uint<128>
  };
}
