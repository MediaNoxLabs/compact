      "predecessor_reconstruction": [
        {
          "current": "use crate::{RenderError, naming};\n\n#[path = \"reference.rs\"]\nmod reference;\n\nfn compare(name: &str) {\n    let old = reference::ident(name).map(|identifier| {\n        let spelling = identifier.to_string();\n        // ADR0476 / #626: one deliberately corrected target spelling. The\n        // frozen oracle still decides acceptance, errors and semantic keys.\n        if spelling == \"gen\" {\n            \"r#gen\".to_owned()\n        } else {\n            spelling\n        }\n    });\n    let new = check_name(name).map(|name| naming::checked_ident(&name).to_string());\n    assert_eq!(new, old, \"rendered identifier for {name:?}\");\n    assert_eq!(\n        naming::semantic_identifier(name),\n        reference::semantic_identifier(name),\n        \"semantic identifier for {name:?}\"\n",
          "previous": "use crate::{RenderError, naming};\n\n#[path = \"reference.rs\"]\nmod reference;\n\nfn compare(name: &str) {\n    let old = reference::ident(name).map(|identifier| identifier.to_string());\n    let new = check_name(name).map(|name| naming::checked_ident(&name).to_string());\n    assert_eq!(new, old, \"rendered identifier for {name:?}\");\n    assert_eq!(\n        naming::semantic_identifier(name),\n        reference::semantic_identifier(name),\n        \"semantic identifier for {name:?}\"\n"
        },
        {
          "current": "#[test]\nfn normalized_namespace_collisions_match_old_semantic_keys() {\n    for (first, second) in [\n        (\"a$b\", \"a_b\"),\n        (\"foo\", \"r#foo\"),\n        (\"type\", \"r#type\"),\n        (\"gen\", \"r#gen\"),\n        (\"/* comment */gen\", \"gen\"),\n        (\"/* comment */foo\", \"foo\"),\n        (\"\\u{feff}foo\", \"foo\"),\n        (\"\u00e9\", \"r#\u00e9\"),\n        (\"$foo\", \"_foo\"),\n    ] {\n        let key = reference::semantic_identifier(first).unwrap();\n",
          "previous": "#[test]\nfn normalized_namespace_collisions_match_old_semantic_keys() {\n    for (first, second) in [\n        (\"a$b\", \"a_b\"),\n        (\"foo\", \"r#foo\"),\n        (\"type\", \"r#type\"),\n        (\"/* comment */foo\", \"foo\"),\n        (\"\\u{feff}foo\", \"foo\"),\n        (\"\u00e9\", \"r#\u00e9\"),\n        (\"$foo\", \"_foo\"),\n    ] {\n        let key = reference::semantic_identifier(first).unwrap();\n"
        },
