import CompactStandardLibrary;
witness suppliedPoint(): JubjubPoint;
export ledger result: JubjubPoint;
constructor() { result = ecMulGenerator(0); }
export circuit from_witness(selected: Boolean): JubjubPoint {
  if (disclose(selected)) {
    result = disclose(ecAdd(suppliedPoint(), ecMulGenerator(1)));
  } else {
    result = disclose(ecMul(suppliedPoint(), 2));
  }
  return result;
}
