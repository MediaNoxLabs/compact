import CompactStandardLibrary;
export ledger aliases: Set<Opaque<"string">>;
export ledger count: Counter;
export enum Mutation { Undefined, Insert, Remove }
circuit defined(m: Mutation): [] {
  assert(m == Mutation.Insert || m == Mutation.Remove, "undefined mutation");
}
circuit bump(): [] { count.increment(1); }
export circuit insert_control(v: Opaque<"string">): [] { aliases.insert(disclose(v)); }
export circuit remove_control(v: Opaque<"string">): [] { aliases.remove(disclose(v)); }
export circuit member_control(v: Opaque<"string">): Boolean { return aliases.member(disclose(v)); }
export circuit mutate(v: Opaque<"string">, m: Mutation): [] {
  const value = disclose(v);
  const mutation = disclose(m);
  defined(mutation);
  if (mutation == Mutation.Insert) {
    assert(!aliases.member(value), "already present");
    aliases.insert(value);
  } else if (mutation == Mutation.Remove) {
    assert(aliases.member(value), "absent");
    aliases.remove(value);
  }
  bump();
}
