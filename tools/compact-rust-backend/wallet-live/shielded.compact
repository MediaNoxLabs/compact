// Local acceptance fixture: bootstrap is an actual on-chain mint, never a
// substitute for confirmed wallet ownership or a production mint policy.
import CompactStandardLibrary;

// The acceptance builder derives coin color/value and commitment from this
// domain, deployed address and actual wallet key; strict ledger checks remain.
export circuit bootstrap(
  domain: Bytes<32>, amount: Uint<64>, coin: ShieldedCoinInfo,
  recipient: Either<ZswapCoinPublicKey, ContractAddress>, commitment: Bytes<32>
): [] {
  kernel.mintShielded(disclose(domain), disclose(amount));
  createZswapOutput(disclose(coin), disclose(recipient));
  kernel.claimZswapCoinSpend(disclose(commitment));
}

export circuit accept(coin: ShieldedCoinInfo): [] {
  receiveShielded(disclose(coin));
}

export circuit release(
  coin: QualifiedShieldedCoinInfo,
  recipient: ZswapCoinPublicKey,
  amount: Uint<128>
): ShieldedSendResult {
  return sendShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    disclose(amount)
  );
}
