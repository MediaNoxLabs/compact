import CompactStandardLibrary;
export ledger padding_00: Field;
export ledger padding_01: Field;
export ledger padding_02: Field;
export ledger padding_03: Field;
export ledger padding_04: Field;
export ledger padding_05: Field;
export ledger padding_06: Field;
export ledger padding_07: Field;
export ledger padding_08: Field;
export ledger padding_09: Field;
export ledger padding_10: Field;
export ledger padding_11: Field;
export ledger padding_12: Field;
export ledger padding_13: Field;
export ledger padding_14: Field;
export ledger padding_15: Field;
export ledger pot: Set<QualifiedShieldedCoinInfo>;
export circuit insert_coin(coin: ShieldedCoinInfo, recipient: Either<ZswapCoinPublicKey, ContractAddress>): [] {
  pot.insertCoin(disclose(coin), disclose(recipient));
}
export circuit contains(coin: QualifiedShieldedCoinInfo): Boolean { return pot.member(disclose(coin)); }
