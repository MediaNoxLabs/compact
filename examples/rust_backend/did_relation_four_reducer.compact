import CompactStandardLibrary;
export enum Relation { Undefined, Authentication, Agreement, Invocation, Delegation }
export ledger authentication: Set<Opaque<"string">>;
export ledger agreement: Set<Opaque<"string">>;
export ledger invocation: Set<Opaque<"string">>;
export ledger delegation: Set<Opaque<"string">>;
circuit member(relation: Relation, id: Opaque<"string">): Boolean {
  if (relation == Relation.Authentication) { return authentication.member(id); }
  else if (relation == Relation.Agreement) { return agreement.member(id); }
  else if (relation == Relation.Invocation) { return invocation.member(id); }
  else if (relation == Relation.Delegation) { return delegation.member(id); }
  return false;
}
circuit insert(relation: Relation, id: Opaque<"string">): [] {
  if (relation == Relation.Authentication) { authentication.insert(id); }
  else if (relation == Relation.Agreement) { agreement.insert(id); }
  else if (relation == Relation.Invocation) { invocation.insert(id); }
  else if (relation == Relation.Delegation) { delegation.insert(id); }
}
circuit remove(relation: Relation, id: Opaque<"string">): [] {
  if (relation == Relation.Authentication) { authentication.remove(id); }
  else if (relation == Relation.Agreement) { agreement.remove(id); }
  else if (relation == Relation.Invocation) { invocation.remove(id); }
  else if (relation == Relation.Delegation) { delegation.remove(id); }
}
export circuit update(relation: Relation, id: Opaque<"string">, add: Boolean): [] {
  const r = disclose(relation);
  const key = disclose(id);
  const m = disclose(add);
  assert(r != Relation.Undefined, "undefined relation");
  const present = member(r, key);
  if (m) {
    assert(!present, "already present");
    insert(r, key);
  } else {
    assert(present, "missing relation");
    remove(r, key);
  }
}
