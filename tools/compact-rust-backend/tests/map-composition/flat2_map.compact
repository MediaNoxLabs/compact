import CompactStandardLibrary;
export struct Pair { label: Opaque<"string">, target: Opaque<"string"> }
export ledger entries: Map<Opaque<"string">, Pair>;
export ledger count: Counter;
circuit bump(): [] { count.increment(1); }
export circuit put(key: Opaque<"string">, value: Pair): [] {
  entries.insert(disclose(key), disclose(value));
  bump();
}
export circuit drop(key: Opaque<"string">): [] {
  assert(entries.member(disclose(key)), "missing");
  entries.remove(disclose(key));
  bump();
}
