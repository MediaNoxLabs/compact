import CompactStandardLibrary;
export ledger result: JubjubPoint;
constructor() { result = ecMulGenerator(0); }
export circuit invalid(selected: Boolean, x: Field, y: Field): JubjubPoint {
  if (disclose(selected)) {
    result = disclose(ecMul(constructJubjubPoint(x, y), 1));
  } else {
    result = ecMulGenerator(0);
  }
  return result;
}
