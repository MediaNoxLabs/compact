import CompactStandardLibrary;

export ledger table: Map<Boolean, Field>;

export circuit put(key: Boolean, value: Field): [] {
  table.insert(disclose(key), disclose(value));
}

export circuit has(key: Boolean): Boolean {
  return table.member(disclose(key));
}

export circuit get(key: Boolean): Field {
  return table.lookup(disclose(key));
}

export circuit remove_key(key: Boolean): [] {
  table.remove(disclose(key));
}

export circuit table_size(): Uint<64> {
  return table.size();
}

export circuit table_is_empty(): Boolean {
  return table.isEmpty();
}

export circuit reset_table(): [] {
  table.resetToDefault();
}
