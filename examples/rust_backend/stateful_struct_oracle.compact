import CompactStandardLibrary;
export ledger marker: Field;
export struct Snapshot { first: Uint<128>; address: ContractAddress; second: Uint<128>; }
export struct Bundle { head: Snapshot; tail: Uint<128>; }
export struct Planned { first: Uint<128>; emitted: []; address: ContractAddress; after: Uint<128>; }
witness next_value(tag: Uint<8>): Uint<64>;
export circuit snapshot(selected: Boolean): Snapshot {
  if (disclose(selected)) {
    return Snapshot { first: disclose(next_value(1)) as Uint<128>, address: kernel.self(), second: disclose(next_value(2)) as Uint<128> };
  } else { return default<Snapshot>; }
}
export circuit reverse(): Snapshot {
  return Snapshot { second: disclose(next_value(2)) as Uint<128>, address: kernel.self(), first: disclose(next_value(1)) as Uint<128> };
}
export circuit nested(): Bundle {
  return Bundle { head: snapshot(true), tail: disclose(next_value(3)) as Uint<128> };
}
export circuit planned(coin: ShieldedCoinInfo, recipient: Either<ZswapCoinPublicKey, ContractAddress>): Planned {
  return Planned { first: disclose(next_value(3)) as Uint<128>, emitted: createZswapOutput(coin,recipient), address: kernel.self(), after: disclose(next_value(4)) as Uint<128> };
}
export circuit pure_snapshot(first: Uint<64>, second: Uint<64>): Snapshot {
 return Snapshot { first: first as Uint<128>, address: default<ContractAddress>, second: second as Uint<128> };
}
