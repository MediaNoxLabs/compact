import CompactStandardLibrary;
export ledger stored: Field;
witness next_value(seed: Field): Field;

export circuit two(): Field {
  const before = stored.read();
  const after = before + 1;
  stored.write(after);
  return after;
}
export circuit three(): Field {
  const before = stored.read();
  const middle = before + 1;
  const after = middle + 2;
  stored.write(after);
  return after;
}
export circuit echo(echo: Field): Field {
  const before = stored.read();
  const after = before + 1;
  stored.write(after);
  return echo;
}
export circuit observed(reject: Boolean): Field {
  const before = stored.read();
  const delta = disclose(next_value(before));
  assert(!reject, "rejected after witness");
  const after = before + delta;
  stored.write(after);
  return after;
}
circuit inner(): Field {
  const before = stored.read();
  const after = before + 1;
  stored.write(after);
  return after;
}
export circuit nested(): Field { return inner(); }
