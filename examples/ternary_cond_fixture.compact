//
// Ternary fixture: conditional (ternary) expressions in every
// sub-expression position and body route the rust backend's shared
// expression renderer must handle.
//
// Before the fix, `expr-rust` (compiler/rust-passes-emit.ss) had no
// clause for the `(if c e1 e2)` IR shape, and `expr-supported?`
// (compiler/rust-passes-walker.ss) rejected any body containing one
// before emission was even attempted. The TS backend compiled all of
// these; only `--target rust` failed:
//
//   - const-RHS ternary in a PURE circuit bailed with
//     `pure-circuit-body-emission: no walker shape matched pure
//     circuit body` (the midnight-verifiable-credential-digital-passport
//     failure),
//   - the same shape in an IMPURE circuit failed the walkability gate
//     (`circuit-body-emission`),
//   - and in a CONSTRUCTOR it died with a location-less `expr-variant`.
//
// The lowering must also be LAZY per the language spec (only the
// selected branch is evaluated): a Rust `if` expression, never an
// eager evaluate-both-then-select. `pick` is the laziness oracle —
// `c = 9` takes the else branch, so the underflowing `c - 10` in the
// then branch must never be evaluated (an eager lowering would trap a
// valid execution).
//
// Circuits, in increasing order of what they exercise:
//   - `pick`: return-position ternary (worked before the fix via the
//     statement-position if lifting — kept as a regression) whose
//     then-branch carries a guarded `-`; THE laziness oracle.
//   - `constPick`: const-RHS ternary in a pure circuit — the exact
//     digital-passport failure shape; also pins the inverse oracle
//     (c = 0 takes the guarded then branch and must trap).
//   - `assertDay`: ternary as an assert argument (leap-day bound).
//   - `decrement`: ternary as an interior arithmetic operand.
//   - `andOrBranches`: `&&` / `||` expressions as branch values.
//   - `chooseStruct`: NESTED ternary with struct-valued branches.
//   - `chooseLabel`: enum-valued branches.
//   - `recordPick`: a const ternary in an impure, ledger-writing
//     circuit, with an assert so both Ok and Err sides execute. Its
//     condition is a Boolean parameter and its assert uses `!=` on
//     purpose: impure bodies route through the `expr-supported?`
//     walkability gate, which (pre-existing, independent of ternaries)
//     admits no ordering comparisons (`<`, `<=`, `>`, `>=`) and no
//     `seq`-guarded subtraction in expression position — so the
//     guarded `-` and the `c > 15` comparison stay in the pure and
//     constructor routes, which do not gate through that predicate.
//   - the constructor: the same const ternary as `pick`, written to the
//     ledger so `initial_state()` (and the byte-parity reference) pins
//     the constructor body route — including its guarded `-`.
//
// Ternary literal-arm coercion (two further gaps, both found by the
// digital-passport dogfood review):
//   - `recordLiteralPick`: a const ternary whose arms are BOTH integer
//     literals, written to a Uint ledger. With both arms bare, Rust
//     infers the whole `if c { 10 } else { 20 }` as i32 and the
//     ledger-write builder's `Into<AlignedValue>` bound fails (E0277);
//     the emitter must suffix each arm from the binding's declared
//     type (coerce-literal-if-rhs-rendered in rust-passes-emit.ss).
//   - `recordFieldPick`: the Field-typed twin — the arms must render as
//     `Fr::from(1u64)` / `Fr::from(0u64)` to satisfy the same bound on
//     a Field ledger.
//   - `fieldBranches` / `recordFieldBranches`: ternary branches that
//     are Field comparisons (`jubjubPointX(p) != 0 as Field`). The
//     literal `0` must render as `Fr::from(0u64)` in EVERY body route
//     (pure circuits via eq-operand-rust, impure/constructor bodies
//     via ctor-expr-rust's if clause) — a bare `0` fails E0308 against
//     the Fr the native returns while compactc still exits 0.

import CompactStandardLibrary;

struct Choice {
  low: Boolean;
  value: Uint<64>;
}

enum Label {
  hot,
  cold,
}

export ledger lastPick: Uint<64>;
export ledger picks: Counter;
export ledger origin: Field;

// Constructor route: the same const ternary as `pick`, written to the
// ledger so the captured after-init state bytes pin it.
constructor(start: Uint<64>) {
  const initial = start > 15 ? start - 10 : start;
  lastPick = disclose(initial);
}

// Laziness oracle + return-position regression. `c = 9` must return 9
// WITHOUT evaluating `c - 10` (else branch taken); `c = 20` computes
// the guarded subtraction and returns 10.
export pure circuit pick(c: Uint<64>): Uint<64> {
  return c > 15 ? c - 10 : c;
}

// Const-RHS ternary in a pure circuit — the digital-passport failure
// shape. `c = 5` skips the guarded then branch; `c = 2` takes it; and
// `c = 0` takes it and must TRIP the underflow guard (taken branch
// traps), the inverse of pick's oracle.
export pure circuit constPick(c: Uint<64>): Uint<64> {
  const x = c <= 2 ? c - 1 : c;
  return x;
}

// UNANNOTATED const with both-literal arms feeding the return — the
// let*-lifted `(seq (= v <lit-if>) v)` route (typescript-passes lowers
// the unannotated const + return as an expression-level let*). With the
// let kept, the binding strands at its own minimal width with no
// context to unify against and `Ok(x)` fails E0308 (or i32 overflows
// for the big-literal twin below); the lowering inlines the literal-if
// at the tail so the return context sizes the arms — byte-identical to
// the no-const `pick` form. The executing test pins both arm values.
export pure circuit literalPick(hot: Boolean): Uint<64> {
  const picked = hot ? 10 : 20;
  return picked;
}

// The big-literal twin: 5000000000 exceeds i32::MAX, so a bare arm
// cannot even default to i32 — found by the dogfood review as a
// regression where compactc exited 0 and rustc failed with `literal
// out of range for 'i32'`.
export pure circuit bigLiteralPick(hot: Boolean): Uint<64> {
  const picked = hot ? 5000000000 : 0;
  return picked;
}

// Ternary in an assert argument: which day bound applies depends on
// the leap flag, and the assert must see the selected comparison only.
export pure circuit assertDay(day: Uint<64>, isLeap: Boolean): [] {
  assert(isLeap ? day <= 29 : day <= 28, "day out of range for the month");
}

// Ternary as an interior arithmetic operand.
export pure circuit decrement(n: Uint<64>, flag: Boolean): Uint<64> {
  return n - (flag ? 1 : 0);
}

// `&&` / `||` as branch values: both branches reduce to `b`, so any
// eager-then-select lowering that evaluated the WRONG branch shape
// still yields `b` — but the emitted `&&`/`||` operands are pinned by
// the executing test.
export pure circuit andOrBranches(a: Boolean, b: Boolean): Boolean {
  return a ? (a && b) : (a || b);
}

// Nested ternary with struct-valued branches: the outer else and both
// inner arms produce `Choice` values, so the generated Rust arms must
// unify to one type.
export pure circuit chooseStruct(c: Uint<64>): Choice {
  return c > 15
    ? (c > 30
        ? Choice { low: false, value: c - 10 }
        : Choice { low: false, value: c - 5 })
    : Choice { low: true, value: c };
}

// Enum-valued branches.
export pure circuit chooseLabel(c: Uint<64>): Label {
  return c > 15 ? Label.hot : Label.cold;
}

// Impure route: a const ternary inside a ledger-writing circuit, with
// an assert so both the Ok and Err(AssertionFailed) sides execute. The
// Boolean condition, `!=` assert, and non-trapping branches are
// deliberate: impure bodies gate through `expr-supported?`, which
// (pre-existing, ternary or not) admits no ordering comparisons and no
// expression-position `seq` guards — those live in the pure and
// constructor routes instead.
export circuit recordPick(c: Uint<64>, hot: Boolean): [] {
  assert(c != 0, "pick input must be non-zero");
  const picked = hot ? 10 : c;
  lastPick.write(disclose(picked));
  picks.increment(1);
}

// Both arms are integer literals: nothing in the arms gives Rust's
// inference a type, so the generated `let picked = if hot { 10 } else
// { 20 };` must carry the declared width on each arm (`10u8`/`20u8`)
// or the write's `Into<AlignedValue>` bound fails E0277. Both flag
// values are driven by the executing test, so the committed VALUE of
// each arm is pinned too.
export circuit recordLiteralPick(hot: Boolean): [] {
  const picked = hot ? 10 : 20;
  lastPick.write(disclose(picked));
  picks.increment(1);
}

// The Field-typed twin: the arms render as `Fr::from(1u64)` /
// `Fr::from(0u64)` from the binding's declared Field type, the ternary
// analogue of the whole-RHS Prod-9 literal coercion.
export circuit recordFieldPick(c: Boolean): [] {
  const picked: Field = c ? 1 : 0;
  origin.write(disclose(picked));
  picks.increment(1);
}

// Field-comparison ternary branches in the PURE route: each arm is a
// `!=` whose literal operand must render `Fr::from(0u64)` (a bare `0`
// fails E0308 against the Fr jubjubPointX/Y return). The identity
// point selects false arms, the generator true arms.
export pure circuit fieldBranches(flag: Boolean, p: JubjubPoint): Boolean {
  const populated = flag
    ? (jubjubPointX(p) != 0 as Field)
    : (jubjubPointY(p) != 0 as Field);
  return populated;
}

// The impure twin: same const ternary, an assert so the Err side
// (identity point → populated false) executes, and a ledger increment
// so the Ok side commits.
export circuit recordFieldBranches(flag: Boolean, p: JubjubPoint): [] {
  const populated = flag
    ? (jubjubPointX(p) != 0 as Field)
    : (jubjubPointY(p) != 0 as Field);
  assert(populated, "point must be non-origin");
  picks.increment(1);
}

// ---------------------------------------------------------------------
// Mixed-arm Field joins and route gaps (dogfood review, round 2). The
// both-literal circuits above only proved the both-literal coercion;
// the review found the MIXED shape (`flag ? x : 0` with x: Field)
// broken in every route, the operand/return positions uncovered, the
// streaming const emitter missing the coercion entirely, and the
// streaming cell-write missing the destination-width cast:
//
//   - `mixedFieldJoin`: PURE const-RHS with a mixed arm — the literal
//     arm must render `Fr::from(0u64)` (an integer literal never
//     unifies with the other arm's `Fr`; E0308 while compactc exits
//     0).
//   - `returnField`: RETURN position — the frontend lifts the ternary
//     to an if STATEMENT, so the literal becomes its own branch tail;
//     the tail must render `Fr::from(0u64)` from the circuit's Field
//     return type.
//   - `fieldEqOperand` / `fieldAddOperand`: the ternary as an OPERAND
//     of a Field `==` / `+` — the literal arm must coerce inside the
//     operand render, not just at const-bindings.
//   - `recordMixedFieldPick`: the impure (walker-route) twin of
//     `mixedFieldJoin`, writing the mixed join to the Field ledger.
//   - `assertFieldEqOperand`: the impure twin of `fieldEqOperand` —
//     the walker's comparison-operand renderer carries the same
//     coercion.
//   - `streamLiteralPick`: the non-terminal `if` forces the STREAMING
//     route; its const emitter predates the literal coercion, so the
//     same `shown ? 10 : 20` that the walker route suffixed emitted an
//     i32-defaulted if into `new_cell` (E0277).
//   - `streamNarrowWrite`: the streaming cell-write predates the
//     destination-width cast, so a Uint<8> value into the Uint<64>
//     field committed a 1-byte cell where every other route (and the
//     TS reference) commits 8 — same decoded value, divergent state
//     bytes. The executing test byte-compares the post-circuit state
//     against the TS reference.
//   - `inlineBigPick`: an INLINE both-literal write (no const binding,
//     so no decl-type to size from) — the write site itself must size
//     the arms from the destination field; bare arms default to i32
//     and `5000000000` cannot even do that.

export pure circuit mixedFieldJoin(flag: Boolean, x: Field): Field {
  const p: Field = flag ? x : 0;
  return p;
}

export pure circuit returnField(flag: Boolean, x: Field): Field {
  return flag ? x : 0;
}

export pure circuit fieldEqOperand(f: Field, c: Boolean): Boolean {
  return f == (c ? 1 : 0);
}

export pure circuit fieldAddOperand(f: Field, c: Boolean): Field {
  return f + (c ? 1 : 0);
}

export circuit recordMixedFieldPick(x: Field, flag: Boolean): [] {
  const picked: Field = flag ? x : 0;
  origin.write(disclose(picked));
  picks.increment(1);
}

export circuit assertFieldEqOperand(f: Field, c: Boolean): [] {
  assert(f == (c ? 1 : 0), "f must equal the picked literal");
  picks.increment(1);
}

export circuit streamLiteralPick(hot: Boolean): [] {
  const shown = disclose(hot);
  const picked = shown ? 10 : 20;
  lastPick.write(disclose(picked));
  if (shown) {
    picks.increment(1);
  } else {
    picks.increment(2);
  }
  picks.increment(3);
}

export circuit streamNarrowWrite(hot: Boolean, v: Uint<8>): [] {
  const flag = disclose(hot);
  const dv = disclose(v);
  lastPick.write(dv);
  if (flag) {
    picks.increment(1);
  } else {
    picks.increment(2);
  }
  picks.increment(3);
}

export circuit inlineBigPick(hot: Boolean): [] {
  const shown = disclose(hot);
  lastPick.write(disclose(shown ? 5000000000 : 0));
  picks.increment(1);
}

// ---------------------------------------------------------------------
// Non-Copy ternary arms (dogfood review, round 3 — Bug-12). Every fix
// above sized or coerced literal arms; the review's validation pass
// found the MOVE side of the if-expression lowering entirely missing:
// a Rust `if` EXPRESSION moves the taken arm's value out of its owner,
// so a struct-typed arm that is a bare var-ref and is later re-read
// emits E0382 (borrow of moved value) at cargo build while compactc
// exits 0 — and every other value position (call args, Bug-6 let RHS)
// already clones non-Copy var-refs, so only the two ternary if-clauses
// (expr-rust in rust-passes-emit.ss, ctor-expr-rust in
// rust-passes-walker.ss) were exposed:
//
//   - `cloneStructPick`: PURE route, both arms are formal struct args
//     and BOTH are re-read in asserts after the pick — statically each
//     arm may move, so the reuse fails E0382 unless every non-Copy var
//     arm carries `.clone()`. (The reads are asserts, not a `+` sum:
//     summing three Uint<64> fields widens past the declared range and
//     the typer refuses — a separate, correct refusal.) The formals'
//     types are recorded, so the clones here are exact (not
//     over-clones). Returns the picked struct so the executing test
//     pins WHICH arm won.
//   - `cloneStructLocal`: the let-lifted twin — `s` is a LOCAL, not a
//     formal, so its type is not in current-formal-arg-types and the
//     arm over-clones: the clone decision for unrecorded locals is
//     type-blind (always clone), so even an arm whose local is never
//     re-read would carry `.clone()`. Safe — a Clone of a Clone type is
//     semantically a no-op — and it pins the conservative direction of
//     the fix. The local IS re-read (`s.low` in the return), so the
//     clone is load-bearing too.
//   - `recordStructPick`: the IMPURE (walker-route) twin of
//     `cloneStructPick` — same both-formals shape through
//     ctor-expr-rust's if clause, committing the picked value to the
//     ledger so the executing test also byte-compares the committed
//     state against the TS reference.
//
// The enum-valued `chooseLabel` never regressed: its arms are enum
// VARIANTS (fresh values), not var-refs. Field arms (`mixedFieldJoin`)
// are Copy per type-rust-copy?, matching how call-arg sites already
// treat them.

export pure circuit cloneStructPick(c: Boolean, s: Choice, s2: Choice): Choice {
  const picked: Choice = c ? s : s2;
  assert(s.value != 100, "s must stay usable after the pick");
  assert(s2.value != 100, "s2 must stay usable after the pick");
  return picked;
}

export pure circuit cloneStructLocal(c: Boolean): Boolean {
  const s = Choice { low: true, value: 7 };
  const picked: Choice = c ? s : Choice { low: false, value: 1 };
  return s.low == picked.low;
}

export circuit recordStructPick(c: Boolean, s: Choice, s2: Choice): [] {
  const picked: Choice = c ? s : s2;
  assert(s.value != 100, "s must stay usable after the pick");
  assert(s2.value != 100, "s2 must stay usable after the pick");
  lastPick.write(disclose(picked.value));
}
