//
// Struct-name collision fixture (rust-passes struct disambiguation).
//
// Two modules each export a struct named `Rec`. The fields have the SAME
// type (Field) but DIFFERENT names (`alpha` vs `beta`). After the frontend
// `expand-modules-and-types` pass inlines both modules, the Rust emitter
// sees two distinct top-level `Rec` tstruct nodes sharing one name — the
// same shape produced by a generic message-protocol module instantiated
// twice (digital-passport's `RequestMessage` / `ResultMessage`).
//
// This locks in two invariants of the Rust codegen:
//
//   1. The struct fingerprint keys on field NAMES as well as field types,
//      so the two `Rec`s are NOT merged into one `pub struct Rec`. A
//      types-only fingerprint would collapse them, and the field accesses
//      below would fail to compile (E0609 no field `beta`).
//
//   2. The disambiguated name (`Rec` / `Rec_1`) is applied at value sites
//      — the struct literal in each circuit body and the `.alpha` / `.beta`
//      field reads — not only in type/signature positions. Emitting the
//      bare `Rec` at the literal while the signature says `Rec_1` would be
//      a type mismatch.
//
// Both circuits CONSTRUCT their struct in the body and READ a field back,
// so the fixture fails to compile if either invariant regresses.
//
// The `Wrap { inner: Inner }` pair adds a NESTED collision: both modules
// also export `struct Inner` and `struct Wrap { inner: Inner }`, with the
// two `Inner`s differing in body. Their `Wrap`s are byte-identical at the
// outer level (`inner: Inner`), so a fingerprint that recorded only the
// bare field-type name would merge them and mis-type one instantiation's
// nested field. Distinguishing them requires the fingerprint to recurse
// into the nested struct's structure.

import CompactStandardLibrary;

module Alpha {
  export struct Rec { alpha: Field }
  export struct Inner { a: Field }
  export struct Wrap { inner: Inner }
  export circuit makeAlpha(x: Field): Rec {
    return Rec { alpha: disclose(x) };
  }
  export circuit wrapAlpha(x: Field): Wrap {
    return Wrap { inner: Inner { a: disclose(x) } };
  }
}

module Beta {
  export struct Rec { beta: Field }
  export struct Inner { b: Boolean }
  export struct Wrap { inner: Inner }
  export circuit makeBeta(y: Field): Rec {
    return Rec { beta: disclose(y) };
  }
  export circuit wrapBeta(y: Boolean): Wrap {
    return Wrap { inner: Inner { b: disclose(y) } };
  }
}

import Alpha prefix a$;
import Beta prefix b$;

export ledger lastAlpha: Field;
export ledger lastBeta: Field;

constructor() {
  lastAlpha = 0;
  lastBeta = 0;
}

export circuit runAlpha(x: Field): [] {
  const r = a$makeAlpha(x);
  lastAlpha = r.alpha;
}

export circuit runBeta(y: Field): [] {
  const r = b$makeBeta(y);
  lastBeta = r.beta;
}

export circuit runWrapAlpha(x: Field): Field {
  const w = a$wrapAlpha(x);
  return w.inner.a;
}

export circuit runWrapBeta(y: Boolean): Boolean {
  const w = b$wrapBeta(y);
  return w.inner.b;
}
