import CompactStandardLibrary;
export struct Quartet { point: JubjubPoint, label: Opaque<"string">, backup: JubjubPoint, note: Opaque<"string"> }
export ledger registry: Map<Opaque<"string">, Quartet>;
export ledger count: Counter;
circuit mark(): [] { count.increment(1); }
export circuit put(id: Opaque<"string">, value: Quartet): [] {
  registry.insert(disclose(id), disclose(value));
  mark();
}
export circuit drop(id: Opaque<"string">): [] {
  assert(registry.member(disclose(id)), "missing");
  registry.remove(disclose(id));
  mark();
}
