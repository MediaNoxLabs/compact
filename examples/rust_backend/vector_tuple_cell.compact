import CompactStandardLibrary;

export ledger values: Vector<3, Field>;
export ledger pair: [Field, Boolean];

export circuit set_values(value: Vector<3, Field>): [] {
  values = disclose(value);
}

export circuit read_values(): Vector<3, Field> {
  return values.read();
}

export circuit set_pair(value: [Field, Boolean]): [] {
  pair = disclose(value);
}

export circuit read_pair(): [Field, Boolean] {
  return pair.read();
}
