import CompactStandardLibrary;

export enum Choice { yes, no }
struct Packet { tag: Bytes<3>; count: Uint<16>; }

export ledger flags: List<Boolean>;
export ledger counts: List<Uint<16>>;
export ledger tags: List<Bytes<3>>;
export ledger choices: List<Choice>;
export ledger packets: List<Packet>;

witness inspect_flags(): Boolean;
witness inspect_counts(): Boolean;
witness inspect_tags(): Boolean;
witness inspect_choices(): Boolean;
witness inspect_packets(): Boolean;

export circuit push_flag(value: Boolean): [] { flags.pushFront(disclose(value)); }
export circuit push_count(value: Uint<16>): [] { counts.pushFront(disclose(value)); }
export circuit push_tag(value: Bytes<3>): [] { tags.pushFront(disclose(value)); }
export circuit push_choice(value: Choice): [] { choices.pushFront(disclose(value)); }
export circuit push_packet(value: Packet): [] { packets.pushFront(disclose(value)); }
export circuit first_packet(): Maybe<Packet> { return packets.head(); }
export circuit first_choice(): Maybe<Choice> { return choices.head(); }

export circuit read_flags(): Boolean { return disclose(inspect_flags()); }
export circuit read_counts(): Boolean { return disclose(inspect_counts()); }
export circuit read_tags(): Boolean { return disclose(inspect_tags()); }
export circuit read_choices(): Boolean { return disclose(inspect_choices()); }
export circuit read_packets(): Boolean { return disclose(inspect_packets()); }
