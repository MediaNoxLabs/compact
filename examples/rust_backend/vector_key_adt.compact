import CompactStandardLibrary;

export ledger keys: Set<Vector<2, Field>>;
export ledger values: Map<Vector<2, Field>, Field>;
export ledger present: Boolean;
export ledger stored: Field;

export circuit setInsert(): [] {
  keys.insert([0 as Field, 1 as Field]);
}

export circuit setMember(): [] {
  present = keys.member([0 as Field, 1 as Field]);
}

export circuit setRemove(): [] {
  keys.remove([0 as Field, 1 as Field]);
}

export circuit mapInsert(): [] {
  values.insert([0 as Field, 1 as Field], 7 as Field);
}

export circuit mapMember(): [] {
  present = values.member([0 as Field, 1 as Field]);
}

export circuit mapLookup(): [] {
  stored = values.lookup([0 as Field, 1 as Field]);
}

export circuit mapRemove(): [] {
  values.remove([0 as Field, 1 as Field]);
}

export circuit mapInsertDefault(): [] {
  values.insertDefault([0 as Field, 1 as Field]);
}
