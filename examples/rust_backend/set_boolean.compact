import CompactStandardLibrary;

export ledger seen: Set<Boolean>;
export ledger fields: Set<Field>;

export circuit add(value: Boolean): [] {
  seen.insert(disclose(value));
}

export circuit contains(value: Boolean): Boolean {
  return seen.member(disclose(value));
}

export circuit add_field(value: Field): [] {
  fields.insert(disclose(value));
}

export circuit contains_field(value: Field): Boolean {
  return fields.member(disclose(value));
}

export circuit remove(value: Boolean): [] {
  seen.remove(disclose(value));
}

export circuit seen_size(): Uint<64> {
  return seen.size();
}

export circuit seen_is_empty(): Boolean {
  return seen.isEmpty();
}

export circuit reset_fields(): [] {
  fields.resetToDefault();
}

export circuit choose(value: Boolean, insert: Boolean): Boolean {
  if (disclose(insert)) {
    if (disclose(value)) {
      seen.insert(true);
    } else {
      seen.insert(false);
    }
  } else {
    seen.remove(disclose(value));
  }
  return seen.member(disclose(value));
}
