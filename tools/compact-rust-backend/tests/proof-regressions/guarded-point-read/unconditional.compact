import CompactStandardLibrary;
export ledger result: JubjubPoint;
constructor() { result = ecMulGenerator(0); }
export circuit unconditional(point: JubjubPoint, scalar: Field): JubjubPoint {
  result = disclose(ecAdd(ecMul(point, scalar), ecMulGenerator(1)));
  return result;
}
