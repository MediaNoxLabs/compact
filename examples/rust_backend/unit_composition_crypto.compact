import CompactStandardLibrary;
import "did_adoption/packages/jubjub-schnorr/src/schnorr" prefix Verify_;
export { Verify_SchnorrSignature };
export ledger controller: JubjubPoint;
export ledger active: Boolean;
export ledger version: Counter;
export ledger updated: Uint<64>;
witness now(): Uint<64>;
struct Binding { version: Uint<64>; }
constructor(key: JubjubPoint) { controller = disclose(key); active = true; }
pure circuit digest(expected: Uint<64>): Vector<4, Field> {
  return [transientHash<Binding>(Binding {version: expected}), 1, 2, 3];
}
circuit authorize(signature: Verify_SchnorrSignature, expected: Uint<64>, message: Vector<4, Field>): [] {
  assert(disclose(expected) == version, "stale");
  Verify_schnorrVerifyDigest(message, signature, controller);
}
circuit note(): [] { version.increment(1); updated = disclose(now()); }
export circuit close(signature: Verify_SchnorrSignature, expected: Uint<64>): [] {
  authorize(signature, expected, digest(disclose(expected)));
  assert(active, "inactive"); active = false; note();
}

// Intentionally has no active guard: recording must preserve this source policy.
export circuit verifyOnly(signature: Verify_SchnorrSignature, expected: Uint<64>): [] {
  authorize(signature, expected, digest(disclose(expected)));
}
