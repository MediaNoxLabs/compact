import CompactStandardLibrary;
export enum Curve { Ed25519, X25519 }
export struct Jwk { curve: Curve, x: Opaque<"string"> }
export struct Method { id: Opaque<"string">, publicKeyJwk: Jwk }
export ledger methods: Map<Opaque<"string">, Method>;
constructor(method: Method) {
  const m = disclose(method);
  methods.insert(m.id, m);
}
export circuit seed(method: Method): [] {
  const m = disclose(method);
  methods.insert(m.id, m);
}
export circuit check(id: Opaque<"string">, agreement: Boolean): [] {
  const key = disclose(id);
  const needsAgreement = disclose(agreement);
  if (needsAgreement) {
    assert(methods.member(key), "missing method");
    const method = methods.lookup(key);
    assert(method.publicKeyJwk.curve == Curve.X25519, "wrong curve");
  } else {
    assert(!methods.member(key) || methods.lookup(key).publicKeyJwk.curve != Curve.X25519, "wrong signing curve");
  }
}
