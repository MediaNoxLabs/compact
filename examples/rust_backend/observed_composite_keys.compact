import CompactStandardLibrary;

struct CompositeKey {
  vector: Vector<2, Field>;
  pair: [Field, Boolean];
}

export ledger vectorKeys: Set<Vector<2, Field>>;
export ledger tupleKeys: Set<[Field, Boolean]>;
export ledger structKeys: Set<CompositeKey>;

export circuit insert_vector(key: Vector<2, Field>): [] {
  vectorKeys.insert(disclose(key));
}

export circuit insert_tuple(key: [Field, Boolean]): [] {
  tupleKeys.insert(disclose(key));
}

export circuit insert_struct(key: CompositeKey): [] {
  structKeys.insert(disclose(key));
}

export circuit roundtrip_tuple(key: [Field, Boolean]): Boolean {
  tupleKeys.insert(disclose(key));
  tupleKeys.remove(disclose(key));
  return tupleKeys.member(disclose(key));
}

export circuit roundtrip_struct(key: CompositeKey): Boolean {
  structKeys.insert(disclose(key));
  structKeys.remove(disclose(key));
  return structKeys.member(disclose(key));
}
