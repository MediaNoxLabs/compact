import CompactStandardLibrary;

export ledger count: Counter;
export ledger last: Uint<64>;
export ledger receipt: Uint<64>;
witness argument(label: Uint<64>): Uint<64>;
witness observe(value: Uint<64>): Uint<64>;
constructor() { last = 0; receipt = 0; }
pure circuit echo(value: Uint<64>): Uint<64> { return value; }
circuit write(value: Uint<64>): [] {
  last = disclose(value);
  count.increment(1);
  receipt = disclose(observe(value));
}
export circuit twice(first: Uint<64>, second: Uint<64>): [] {
  write(argument(echo(first)));
  write(argument(echo(second)));
}
