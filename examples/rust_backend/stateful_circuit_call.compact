import CompactStandardLibrary;

export ledger count: Counter;

export circuit bump(): [] {
  count.increment(1);
}

export circuit bump_twice(): [] {
  bump();
  bump();
}

export circuit add(amount: Uint<16>): [] {
  count.increment(disclose(amount));
}

export circuit add_twice(amount: Uint<16>): [] {
  add(disclose(amount));
  add(disclose(amount));
}
